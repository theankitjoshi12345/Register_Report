# Copy this file to .env for local development.
DJANGO_DEBUG=True
# Replace this placeholder with a unique, private secret.
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For a separately hosted frontend, add its exact HTTPS origin here.
# DJANGO_CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# Set this when the frontend and Django use different sites (HTTPS required).
# DJANGO_CROSS_SITE_COOKIES=True
# Secure session/CSRF cookies default on when debug is off (requires HTTPS).
# DJANGO_SECURE_COOKIES=True

# SQLite at backend/db.sqlite3 is used when DATABASE_URL is unset.
# To use the optional local PostgreSQL service, uncomment this line:
# DATABASE_URL=postgresql://register_report:local-development-only@localhost:5432/register_report
